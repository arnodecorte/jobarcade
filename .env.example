# Copy to .env: cp .env.example .env
# Every variable is optional; the defaults work with a local Ollama.

# Ollama server used for drafting and email classification.
# From inside Docker, host.docker.internal reaches Ollama running on your machine.
JOBHUNT_OLLAMA_URL=http://host.docker.internal:11434

# Model used for CV/letter drafting and classification.
JOBHUNT_OLLAMA_MODEL=qwen2.5:7b

# Optional. API key if you use Ollama cloud instead of a local server.
JOBHUNT_OLLAMA_API_KEY=

# Optional. Firecrawl key for Chameleon brand-theme extraction. The free tier is
# enough. Without it, theme extraction falls back to the local extractor.
FIRECRAWL_API_KEY=

# Set to 1 to enable the job-board scraper. It is off by default.
JOBHUNT_ENABLE_SCRAPER=0

# Optional Gmail sync (read-only job-email tracking). Create OAuth credentials in
# Google Cloud Console and set the redirect URI to match your dashboard URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Key used to encrypt stored Gmail tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=
