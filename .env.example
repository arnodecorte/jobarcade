# Copy to .env on the deployment host: cp .env.example .env
#
# Keep the dashboard loopback-only and expose it privately with Tailscale Serve.
DASHBOARD_BIND_IP=127.0.0.1

# Optional. Enables Firecrawl's branding format for Chameleon theme extraction,
# and (separately) the Discover-pile careers-URL search fallback in
# `jobhunt resolve-candidate-urls`. If unset, theme extraction falls back to
# the deterministic local extractor and the URL search fallback is skipped.
FIRECRAWL_API_KEY=

# Existing Ollama service used for semantic job-email classification.
# These remain fallbacks; System > Integrations can save replacements securely.
# Keep OLLAMA_MODEL the same model CV/letter drafting uses (qwen3:8b) - Ollama
# only keeps one model resident at a time, so alternating models mid-run forces
# a reload each time.
OLLAMA_BASE_URL=http://ollama-core:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CLASSIFIER_TIMEOUT=45
